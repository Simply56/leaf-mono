{
    "name": "leaf-ng-nest-mono",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev:web": "npm start -w web",
        "dev:api": "npm run start:dev -w api",
        "dev:shared": "npm run watch -w @leaf/shared",
        "build": "npm run build -w @leaf/shared && npm run build -w web -w api",
        "build:shared": "npm run build -w @leaf/shared",
        "build:web": "npm run build -w web",
        "build:api": "npm run build -w api",
        "test": "npm test -w api",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "eslint": "^10.13.0",
        "prettier": "^3.8.1",
        "typescript-eslint": "^8.71.0"
    },
    "allowScripts": {
        "better-sqlite3@12.11.1": true
    }
}
